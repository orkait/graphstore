digraph architecture {
  rankdir=LR;
  bgcolor="transparent";
  graph [fontname="Helvetica", fontsize=11, splines=polyline, nodesep=0.4, ranksep=0.7];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
         color="#475569", fontcolor="#0f172a", penwidth=1.2, margin="0.18,0.10"];
  edge  [fontname="Helvetica", fontsize=10, color="#64748b", penwidth=1.2, arrowsize=0.7];

  user   [label="User / Agent", shape=ellipse, fillcolor="#e0f2fe"];
  dsl    [label="DSL\nLark LALR(1)\n70+ commands", fillcolor="#f1f5f9"];
  gnode  [label="Graph\nnumpy + CSR", fillcolor="#dbeafe"];
  vec    [label="Vector\nusearch HNSW", fillcolor="#dbeafe"];
  doc    [label="Document\nSQLite + FTS5", fillcolor="#dbeafe"];
  ingest [label="Ingest\ntiered + modality", fillcolor="#dcfce7"];

  user   -> dsl;
  dsl    -> gnode;
  dsl    -> vec;
  dsl    -> doc;
  ingest -> gnode;
  ingest -> vec;
  ingest -> doc;

  { rank=same; gnode; vec; doc; }
}
