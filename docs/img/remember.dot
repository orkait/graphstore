digraph remember {
  rankdir=LR;
  bgcolor="transparent";
  graph [fontname="Helvetica", fontsize=11, splines=polyline, nodesep=0.3, ranksep=0.5];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
         color="#475569", fontcolor="#0f172a", penwidth=1.2, margin="0.18,0.10"];
  edge  [fontname="Helvetica", fontsize=10, color="#64748b", penwidth=1.2, arrowsize=0.7];

  q        [label="REMEMBER\n\"query\"", shape=ellipse, fillcolor="#e0f2fe"];
  gather   [label="Gather\nvector ANN +\nBM25 FTS5", fillcolor="#f1f5f9"];
  fuse     [label="Fuse\nweighted | rrf", fillcolor="#dbeafe"];
  temporal [label="Temporal\nAT filter", fillcolor="#f1f5f9"];
  rerank   [label="Rerank\n(optional)", fillcolor="#f1f5f9", style="rounded,dashed,filled"];
  nucleus  [label="Nucleus\n(optional)", fillcolor="#f1f5f9", style="rounded,dashed,filled"];
  out      [label="Ranked nodes", shape=ellipse, fillcolor="#dcfce7"];

  q -> gather -> fuse -> temporal -> rerank -> nucleus -> out;
}
