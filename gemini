  140      crate::exec::pipeline::exec_payload(req)
  141  }
  142  fn wait_for_payload_and_reap(payload_pid: Pid) -> Result<(Option<i32>, Option<i32>, u32)> {
  143      let mut payload_exit: Option<i32> = None;
  144      let mut payload_signal: Option<i32> = None;
  145      let mut reaped_descendants: u32 = 0;
  146      loop {
  147          match waitpid(payload_pid, None) {
  148              Ok(WaitStatus::Exited(_, code)) => {
  149                  payload_exit = Some(code);
  150                  break;
  151              }
  152              Ok(WaitStatus::Signaled(_, sig, _)) => {
  153                  payload_signal = Some(sig as i32);
  154                  break;
  155              }
  156              Ok(_) => continue,
  157              Err(Errno::EINTR) => continue,
  158              Err(e) => return Err(IsolateError::process("waitpid(payload)", e)),
  159          }
  160      }
  161      loop {
  162          match waitpid(Pid::from_raw(-1), Some(WaitPidFlag::WNOHANG)) {
  163              Ok(WaitStatus::StillAlive) => break,
  164              Ok(WaitStatus::Exited(_, _) | WaitStatus::Signaled(_, _, _) | WaitStatus::Stopped(_, _) | WaitStatus::Continued(_) | WaitStatus::PtraceEvent(_, _, _) | WaitStatus::PtraceSyscall(_)) => {
  165                  reaped_descendants += 1;
  166              }
  167              Err(Errno::ECHILD) => break,
  168              Err(Errno::EINTR) => continue,
  169              Err(e) => return Err(IsolateError::process("waitpid(reap)", e)),
  170          }
  171      }
  172      Ok((payload_exit, payload_signal, reaped_descendants))
  173  }
  174  fn run_proxy(req: &SandboxLaunchRequest) -> Result<i32> {
  175      let _ = nix::unistd::setpgid(Pid::from_raw(0), Pid::from_raw(0));
  176      crate::exec::preexec::setup_parent_death_signal()?;
  177      let (stdin_read, stdin_write) = nix::unistd::pipe().map_err(|e| IsolateError::process("pipe(stdin)", e))?;
  178      let payload_pid = match unsafe { fork() }.map_err(|e| IsolateError::process("fork(payload)", e))? {
  179          ForkResult::Child => {
  180              let _ = close(stdin_write);
  181              dup2(stdin_read, libc::STDIN_FILENO).map_err(|e| IsolateError::process("dup2(stdin)", e))?;
  182              let _ = close(stdin_read);
  183              if let Err(err) = exec_payload_with_typestate(req) {
  184                  let _ = writeln!(std::io::stderr(), "proxy payload setup failed: {err}");
  185                  std::process::exit(constants::EXIT_EXEC_FAILURE);
  186              }
  187              std::process::exit(constants::EXIT_EXEC_FAILURE);
  188          }
  189          ForkResult::Parent { child } => child,
  190      };
  191      let _ = close(stdin_read);
  192      let stdin_handle = if let Some(data) = req.profile.stdin_data.clone() {
  193          Some(thread::spawn(move || {
  194              let mut writer = unsafe { File::from_raw_fd(stdin_write) };
  195              let _ = writer.write_all(data.as_bytes());
  196          }))
  197      } else {
  198          let _ = close(stdin_write);
  199          None
  200      };
  201      // Note: Stdout and Stderr are directly inherited and streamed by the Supervisor via Tokio async I/O.
  202      let (exit_code, term_signal, _) = wait_for_payload_and_reap(payload_pid)?;
  203      if let Some(h) = stdin_handle {
  204          let _ = h.join();
  205      }
  206      if let Some(sig) = term_signal {
  207          Ok(128 + sig)
  208      } else {
  209          Ok(exit_code.unwrap_or(constants::EXIT_EXEC_FAILURE))
  210      }
  211  }
  212  pub fn run_proxy_role(launch_fd: i32, _status_fd: i32) -> Result<()> {
  213      let outcome = match read_json_from_fd::<SandboxLaunchRequest>(launch_fd).and_then(|req| run_proxy(&req)) {
  214          Ok(code) => code,
  215          Err(err) => {
  216              let _ = writeln!(std::io::stderr(), "proxy setup failed: {err}");
  217              126
  218          }
  219      };
  220      std::process::exit(outcome);
  221  }
